if (!requireNamespace("illuminaHumanv3.db", quietly = TRUE)) {
  BiocManager::install("illuminaHumanv3.db", ask = FALSE)
}

# Install paket anotasi
BiocManager::install(c("illuminaHumanv3.db", "org.Hs.eg.db"))

#3. Install paket CRAN untuk visualisasi dan manipulasi data 
#phetmap: heatmap ekspresi gen 
#ggplot2: grafik (volcano plot)
#dplyr: manipulasi tabel data 

