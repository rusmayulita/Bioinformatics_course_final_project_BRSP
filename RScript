#PART I.3 UMAP (VISUALISASI DIMENSI RENDAH)

#UMAP digunakan untuk:
#- Mereduksi ribuan gen menjadi 2 dimensi
#- Melihat pemisahan sampel secara global

#Transpose matriks ekspresi:
#UMAP bekerja pada OBSERVATION = sampel
library(umap)
library(ggplot2)

# 1) Validasi objek yang ada
stopifnot(exists("gset"), exists("ex"))
stopifnot(all(colnames(ex) == rownames(pData(gset))))
stopifnot(!any(is.na(gset$group)))

# 2) Pastikan data log2 dan finite
qx <- as.numeric(quantile(ex, c(0,.25,.5,.75,.99,1), na.rm = TRUE))
LogC <- (qx[5] > 100) || (qx[6] - qx[1] > 50 && qx[2] > 0)
if (LogC) {
  ex[ex <= 0] <- NA
  ex <- log2(ex)
}
keep <- apply(ex, 1, function(x) all(is.finite(x)))
if (sum(!keep) > 0) ex <- ex[keep, , drop = FALSE]

# 3) Siapkan input UMAP: baris = sampel; standarisasi fitur
X <- t(ex)
X_scaled <- scale(X, center = TRUE, scale = TRUE)
X_scaled[!is.finite(X_scaled)] <- 0

#UMAP
set.seed(123)
cfg <- umap.defaults
cfg$n_neighbors <- 15
cfg$min_dist    <- 0.1
um <- umap(X_scaled, config = cfg)
emb <- um$layout
colnames(emb) <- c("UMAP1","UMAP2")

#Plot
palette <- c("LATENT.TB"="steelblue","PTB"="tomato")
df_umap <- data.frame(UMAP1 = emb[,1], UMAP2 = emb[,2],
                      Group = factor(gset$group, levels = c("LATENT.TB","PTB")))

ggplot(df_umap, aes(UMAP1, UMAP2, color = Group)) +
  geom_point(size = 2, alpha = 0.85) +
  scale_color_manual(values = palette, drop = FALSE) +
  labs(title = "UMAP – GSE19442 (PTB vs LATENT.TB)",
       x = "UMAP1", y = "UMAP2") +
  theme_minimal(base_size = 12)


#PART J.1 VISUALISASI VOLCANO PLOT 

#Volcano plot menggabungkan:
#- Log fold change (efek biologis)
#- Signifikansi statistik
library(ggplot2)

alpha <- 0.05
lfc   <- 1     # |log2FC| >= 1 (≈ 2-fold)

tt <- topTable(fit2, adjust="fdr", sort.by="P", number=Inf)
tt$negLogFDR <- -log10(tt$adj.P.Val)
tt$Signif <- with(tt,
  ifelse(adj.P.Val <= alpha & logFC >=  lfc, "Up in PTB",
  ifelse(adj.P.Val <= alpha & logFC <= -lfc, "Down in PTB", "NS"))
)

#Hitung ringkas
table(tt$Signif)
summary(tt$logFC)

#Volcano terfokus (xlim ~ biologis)
library(ggplot2)
pal <- c("Down in PTB"="steelblue", "NS"="grey70", "Up in PTB"="tomato")

ggplot(tt, aes(x=logFC, y=negLogFDR, color=Signif)) +
  geom_point(alpha=0.8, size=1.1) +
  scale_color_manual(values=pal) +
  geom_vline(xintercept=c(-lfc, lfc), linetype="dashed", linewidth=0.5) +
  geom_hline(yintercept=-log10(alpha), linetype="dashed", linewidth=0.5) +
  coord_cartesian(xlim=c(-4, 4)) +  # fokus rentang wajar log2FC
  labs(title="Volcano Plot – GSE19442 (PTB vs LATENT.TB)",
       x="log2 Fold Change (PTB - LATENT.TB)", y="-log10(FDR)") +
  theme_minimal(base_size=12)

