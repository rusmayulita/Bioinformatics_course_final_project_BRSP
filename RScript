#umap: grafik (plot UMAP) 
if (!requireNamespace("umap", quietly = TRUE)) {
  install.packages("umap")
}

#4. Memanggil library 
#library() digunakan agar fungsi di dalam package bisa digunakan 
suppressPackageStartupMessages({
  library(GEOquery)
  library(limma)
  library(Biobase)
  library(pheatmap)
  library(ggplot2)
  library(gplots)
  library(dplyr)
  library(umap)
  library(RColorBrewer)
