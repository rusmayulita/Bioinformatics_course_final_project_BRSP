  geom_density(alpha = 0.7, size = 0.4) +
  scale_color_manual(values = pal) +
  labs(title = "Density Plot Distribusi Nilai Ekspresi Gen – GSE19442",
       x = "Expression value (log2)", y = "Density") +
  theme_minimal(base_size = 11)
print(p1)

#OPTIONAL_Rata-rata densitas per grup (agregat) — lebih bersih untuk presentasi
