  library(illuminaHumanv3.db)
  library(org.Hs.eg.db)
})

#PART C. PENGAMBILAN DATA DARI GEO
#GEO (Gene Expression Omnibus) adalah database publik milik NCBI
#getGEO(): fungsi untuk mengunduh dataset berdasarkan ID GEO 
#Opsi A: dari internet (disarankan untuk konsistensi)
gset_list <- getGEO("GSE19442", GSEMatrix = TRUE, AnnotGPL = FALSE)
if (length(gset_list) > 1) {
  idx <- grep("GPL6947", names(gset_list))
  stopifnot(length(idx) == 1)
  gset <- gset_list[[idx]]
} else {
  gset <- gset_list[[1]]
}

# Opsi B: dari local file (jika mau pakai file lokal)
local_file <- "C:/Users/LENOVO/Dropbox/PC/Documents/BIOINFORMATICS_COURSE/Capstone_Project/GSE19442_series_matrix.txt.gz"
gset <- getGEO(filename = local_file)  # otomatis mengenali ExpressionSet

#PART D. PRE-PROCESSING DATA EKSPRESI 

# exprs(): mengambil matriks ekspresi gen
# Baris  = probe/gen
# Kolom  = sampel
ex    <- exprs(gset)
pdata <- pData(gset)
stopifnot(all(colnames(ex) == rownames(pdata)))  # pastikan urutan sinkron

#PART E. DEFINISI KELOMPOK SAMPEL
#Parser grup yang robust (pemetaan ke “LATENT.TB” vs “PTB” + urutan level tetap)
#Ganti blok group_info/make.names/factor dengan berikut:
# Cari kolom fenotipe yang relevan (agar tahan variasi penamaan)
cand_cols <- grep("(illness|disease|status|group|condition).*(:ch1)?$",
                  names(pdata), ignore.case = TRUE, value = TRUE)
# Pilih salah satu yang paling informatif (cek di RStudio jika perlu)
print(cand_cols); head(pdata[cand_cols])

# Misal kolom yang valid adalah "illness:ch1"
src <- tolower(trimws(as.character(pdata[["illness:ch1"]])))

# Map teks ke dua kelas final: PTB vs LATENT.TB
group <- ifelse(grepl("\\bptb\\b|active|pulmonary", src), "PTB",
                ifelse(grepl("latent|ltbi", src), "LATENT.TB", NA))
group <- factor(group, levels = c("LATENT.TB", "PTB"))
stopifnot(!any(is.na(group)))

# Simpan ke gset agar konsisten di seluruh script
gset$group <- group

# Cek cepat
print(table(gset$group))

#PART F. DESIGN MATRIX (KERANGKA STATISTIK) 

#model.matrix():
#Membuat matriks desain untuk model linear
#~0 berarti TANPA intercept (best practice limma)
#3) Design & kontrast yang eksplisit arahnya
design <- model.matrix(~0 + gset$group)

#colnames(): memberi nama kolom agar mudah dibaca
colnames(design) <- levels(gset$group)

# Tentukan arah kontras secara eksplisit
# PILIH salah satu sesuai tujuan:
#   a) PTB vs LATENT.TB → logFC > 0 artinya lebih tinggi di PTB
#   b) LATENT.TB vs PTB → logFC > 0 artinya lebih tinggi di LATENT.TB
contrast_formula <- "PTB - LATENT.TB"   # ← biasanya ini yang diinginkan
#makeContrasts(): mendefinisikan perbandingan antar grup
contrast_matrix <- makeContrasts(contrasts = contrast_formula, levels = design)

#PART G. ANALISIS DIFFERENTIAL EXPRESSION (LIMMA)

#lmFit():
#Membangun model linear untuk setiap gen
fit  <- lmFit(ex, design)

#contrasts.fit(): menerapkan kontras ke model
fit2 <- contrasts.fit(fit, contrast_matrix)

#eBayes():
#Empirical Bayes untuk menstabilkan estimasi varians
fit2 <- eBayes(fit2)

#tt=topTable():
#Mengambil hasil akhir DEG
#adjust = "fdr" -> koreksi multiple testing
#p.value = 0.05  -> gen sangat signifikan
tt <- topTable(fit2, adjust = "fdr", sort.by = "P", number = Inf, p.value = 0.05)
cat("Jumlah DEG (FDR<=0.05):", nrow(tt), "\n")

##PART H. ANOTASI NAMA GEN 
#Illumina HumanRef-illuminaHumanv3.db (kadang butuh cross-check)
#Anotasi Illumina v3 (hindari duplikasi)
#Karena kita pakai AnnotGPL=FALSE, lakukan anotasi manual berikut:
probe_ids <- rownames(tt)

gene_annotation <- AnnotationDbi::select(
  illuminaHumanv3.db,
  keys = probe_ids,
  columns = c("SYMBOL", "GENENAME"),
  keytype = "PROBEID"
)

#Gabungkan dengan hasil limma
tt$PROBEID <- rownames(tt)
tt_annot   <- merge(tt, gene_annotation, by = "PROBEID", all.x = TRUE)

head(tt_annot[, c("PROBEID", "SYMBOL", "GENENAME", "logFC", "adj.P.Val")])

