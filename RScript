  idx <- grep("GPL6947", names(gset_list))
  stopifnot(length(idx) == 1)
  gset <- gset_list[[idx]]
} else {
  gset <- gset_list[[1]]
}

ex    <- exprs(gset)
pdata <- pData(gset)
stopifnot(all(colnames(ex) == rownames(pdata)))

#Log2 otomatis + bersihkan NA/Inf
qx <- as.numeric(quantile(ex, c(0, .25, .5, .75, .99, 1), na.rm = TRUE))
LogC <- (qx[5] > 100) || (qx[6] - qx[1] > 50 && qx[2] > 0)
if (LogC) {
  ex[ex <= 0] <- NA
  ex <- log2(ex)
}
keep <- apply(ex, 1, function(x) all(is.finite(x)))
if (sum(!keep) > 0) ex <- ex[keep, , drop = FALSE]

#Parser group yang robust (PTB vs LATENT.TB)
cand_cols <- grep("(illness|disease|status|group|condition).*(:ch1)?$",
                  names(pdata), ignore.case = TRUE, value = TRUE)
# Default: coba pakai kolom 'illness:ch1' jika ada, kalau tidak ambil kandidat pertama
src_col <- if ("illness:ch1" %in% names(pdata)) "illness:ch1" else cand_cols[1]
stopifnot(length(src_col) == 1)
src <- tolower(trimws(as.character(pdata[[src_col]])))

group <- ifelse(grepl("\\bptb\\b|active|pulmonary", src), "PTB",
                ifelse(grepl("latent|ltbi", src), "LATENT.TB", NA))
group <- factor(group, levels = c("LATENT.TB","PTB"))
stopifnot(!any(is.na(group)))
gset$group <- group

#Density plot (ggplot2) — overlay per sampel, warna per grup
library(reshape2)  # untuk melt
df_long <- reshape2::melt(ex, varnames = c("Probe","Sample"), value.name = "Expr")
df_long$Group <- gset$group[ match(df_long$Sample, rownames(pdata)) ]

# Palet warna konsisten
pal <- c("LATENT.TB" = "steelblue", "PTB" = "tomato")

#Overlay semua sampel (alpha kecil) — cepat dan informatif
